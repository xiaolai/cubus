# macOS
.DS_Store

# Dependencies — subpackages ignore their own; this covers any root-level install
node_modules/

# ML training + validation output (YOLO / ultralytics)
runs/

# Rust workspace build output
/target

# >>> cc-suite >>>
# cc-suite-schema: 7
# AI assistant local state
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/*.local.*
CLAUDE.local.md

# Codex CLI — local files, keep checked-in subdirs
.codex/*
!.codex/skills/
!.codex/prompts/
!.codex/hooks.json
!.codex/hooks.cc-suite.json
!.codex/config.toml

# cc-suite-managed symlinks (created by bridge_skills.sh) — derived, not authored
.claude/skills/cc-suite
.agents/skills

# Antigravity workspace MCP config is generated from .mcp.json and may contain
# credentials or machine-specific paths.
.agents/mcp_config.json
.agents/.cc-suite-mcp.provenance.json

# cc-suite tool-profile bridge (grok/opencode/qwen) — derived provenance
# sidecars tracking which MCP servers cc-suite owns. Not authored.
.cc-suite-*.provenance.json

# cc-suite local state — what init created, and the pre-bridge CLAUDE.md backup.
# Machine-local bookkeeping, not shared. Listed file-by-file on purpose:
# .cc-suite/agents/ holds declared advisors and IS meant to be committed.
.cc-suite/provenance
.cc-suite/original-claude.md
# Audit findings files written by /cc-suite:audit and the audit-fix loop —
# per-run working state (findings + fix statuses), not authored content.
.cc-suite/audits/
# <<< cc-suite <<<

# Signing material. None of this belongs in the repo, and the cost of one slip is a revoked
# certificate and a re-keyed app listing — Android in particular cannot change its upload key
# without Google's intervention. gen/android/.gitignore already covers keystore.properties;
# these patterns cover the key files themselves, wherever anybody drops them.
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
keystore.properties
key.properties

# A scratch file some tool writes by treating SQLite's `:memory:` DSN as a path — 51 bytes of
# timestamp and UUID, in the repo root. It is not ours and it is not content, but it IS untracked
# junk that `git add -A` happily stages: that near-miss happened on 2026-08-31 and had to be
# undone with `git rm --cached -- './:memory:.ses'` — the leading `./` is required, because a
# bare `:memory:` is git pathspec magic and matches nothing.
:memory:.ses

# Working notes and reasoning: plans, provenance records, measurements, the design kit, and the
# grill reports. Kept locally, not shipped. Code comments and AGENTS.md still cite these paths on
# purpose — the reasoning is worth naming even where the file is not in the clone — so the checks
# that read them (stage.test.mjs, tokens.test.mjs, no-dangling-pointers.test.mjs) SKIP rather than
# pass when they are absent, and say so.
dev-docs/
grill-report-*.md

# Agent tooling configuration. Local to whoever is driving the repo, not part of the project.
.codex/
.cc-suite.md

# Where scripts/check-on-clone.sh parks gitignored dirs for the length of a run. A fixed path so
# an interrupted run is recoverable; the script empties it on the next start.
.check-on-clone-stash/

# Rendered algorithm media (scripts/alg-video.mjs). Generated, large and reproducible: one 4-move
# algorithm is ~3.7 MB across the five formats, and the APNG alone is 2.7 MB. Six of these reached
# a commit because a `git add -A` swept the output directory in, and had to be filtered back out of
# history. Anything the tool writes is a build artefact — put the COMMAND in a doc, not the bytes,
# and re-render when the renderer changes, which is exactly what made those six stale within a day.
#
# The tool's own default output lives under dev-docs/, already ignored above. This covers the other
# common destination, and the extension catches a run pointed somewhere new — an APNG in this repo
# is always something this tool made.
docs/media/
*.apng
