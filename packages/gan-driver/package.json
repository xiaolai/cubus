{
  "name": "gan-driver",
  "version": "0.1.0",
  "type": "module",
  "description": "Verified BLE driver + diagnostic CLI for the GAN16 ui smart cube (GAN Gen4 protocol) on macOS",
  "license": "MIT",
  "bin": {
    "gan16": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts && eslint src",
    "format": "biome format --write src tests scripts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "spike:refresh": "tsx scripts/spike-refresh.ts",
    "spike:serve": "tsx scripts/spike-server.ts"
  },
  "dependencies": {
    "aes-js": "^3.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.9",
    "cubejs": "^1.3.2",
    "eslint": "^9.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.9"
  }
}
