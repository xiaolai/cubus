{
  "name": "cube-scanner",
  "version": "0.1.0",
  "type": "module",
  "description": "Webcam Rubik's Cube face scanner — pure, tested CV core (framework-agnostic) plus a thin browser shell",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src view tests && eslint src",
    "format": "biome format --write src view tests",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:panel": "esbuild view/ai-scan-panel.ts --bundle --format=esm --target=es2022 --outfile=../../apps/web/vendor/ai-scan-panel.js"
  },
  "peerDependencies": {
    "cubejs": "^1.3.2"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.9",
    "cubejs": "^1.3.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.15.0",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.9"
  }
}
