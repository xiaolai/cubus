{
  "name": "cube-scanner",
  "version": "0.1.0",
  "type": "module",
  "description": "Webcam Rubik's Cube face scanner — pure, tested CV core (framework-agnostic) plus a thin browser shell",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src view tests && eslint src view",
    "format": "biome format --write src view tests",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run coverage",
    "build:panel": "esbuild view/ai-scan-panel.ts --bundle --format=esm --target=es2022 --legal-comments=eof --outfile=../../apps/web/vendor/ai-scan-panel.js",
    "build:misread-worker": "esbuild view/misread-worker.ts --bundle --format=esm --target=es2022 --legal-comments=eof --outfile=../../apps/web/vendor/misread-worker.js"
  },
  "peerDependencies": {
    "cubejs": "^1.3.2"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^5.0.0",
    "cubejs": "^1.3.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
