{
  "name": "cubus",
  "version": "0.0.0",
  "private": true,
  "description": "cubus-im — a beginner/kids Rubik's Cube tutor. Web SPA + Tauri app; smart cubes over a linked protocol layer with the transport and the trust model our own.",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bump": "node scripts/bump-version.mjs",
    "dev": "pnpm --filter cubus-web dev",
    "dev:desktop": "pnpm --filter cubus-desktop dev",
    "build:panel": "pnpm --filter cube-scanner build:panel",
    "build:cube": "pnpm --filter cubus-web build:cube",
    "build:desktop": "pnpm --filter cubus-desktop build",
    "check": "pnpm -r run check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "protobufjs",
      "smartcube-web-bluetooth"
    ]
  }
}
