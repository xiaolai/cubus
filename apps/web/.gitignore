node_modules/
*.log

# onnxruntime-web wasm/loader assets — copied from cube-scanner's node_modules by
# `npm run copy-ort`. The AI scanner fetches them at runtime from ./vendor/. Large;
# regenerated from the pinned dependency, not committed.
vendor/ort-wasm-*
vendor/ort.*

# Generated by build.mjs — the isolated web-asset folder Tauri bundles.
dist/

# Vendored solver libraries — bundled from the pinned cubejs/cubing deps by
# `pnpm vendor:libs`. Multi-MB and reproducible, so regenerated rather than committed.
# search-worker-entry.js MUST sit beside cubing.js: cubing resolves its worker
# relative to import.meta.url.
vendor/cubing.js
vendor/search-worker-entry.js
vendor/cubejs.js
