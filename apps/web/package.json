{
  "name": "cubus-web",
  "version": "0.11.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./cube-kit": "./lib/cube-kit.js",
    "./element": "./vendor/cubus-cube.js",
    "./element-manifest": "./vendor/cubus-cube.manifest.json"
  },
  "description": "Cubus SPA — camera cube scanner and solver. Served as a static site; the only build steps are self-contained vendor bundles.",
  "scripts": {
    "copy-ort": "node copy-ort.mjs",
    "build:cube": "pnpm --filter cubus-cube build",
    "predev": "pnpm vendor:libs",
    "dev": "node serve.mjs",
    "pretest": "pnpm vendor:libs",
    "test": "node run-tests.mjs all",
    "pretest:fast": "pnpm vendor:libs",
    "test:fast": "node run-tests.mjs fast",
    "pretest:browser": "pnpm vendor:libs",
    "test:browser": "node run-tests.mjs browser",
    "pretest:nightly": "pnpm vendor:libs",
    "test:nightly": "node run-tests.mjs nightly",
    "check": "pnpm vendor:libs && node run-tests.mjs all",
    "check:fast": "pnpm vendor:libs && node run-tests.mjs fast",
    "build:dist": "node build.mjs",
    "build:cubejs": "esbuild lib/cubejs-entry.js --bundle --format=esm --target=es2022 --legal-comments=eof --outfile=vendor/cubejs.js",
    "build:mcp-guest": "esbuild lib/tauri-mcp-guest-entry.js --bundle --format=esm --target=es2022 --legal-comments=eof --outfile=vendor/tauri-mcp-guest.js",
    "vendor:libs": "node copy-ort.mjs && pnpm build:cubejs",
    "build:smartcube": "esbuild lib/smartcube-entry.js --bundle --format=esm --target=es2022 --legal-comments=eof --outfile=vendor/smartcube.js"
  },
  "devDependencies": {
    "acorn": "8.19.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "1.64.0",
    "smartcube-web-bluetooth": "github:xiaolai/smartcube-web-bluetooth#3d3e05872fb9a560be003d4a68ce34adfc7ae930",
    "tauri-plugin-mcp": "0.3.1"
  },
  "dependencies": {
    "cubejs": "^1.3.2"
  }
}
