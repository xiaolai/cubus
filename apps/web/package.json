{
  "name": "cubus-web",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Cubus SPA — camera (YOLO) cube scanner and solver. Served as a static site; the only build steps are self-contained vendor bundles.",
  "scripts": {
    "copy-ort": "node copy-ort.mjs",
    "build:cube": "esbuild lib/cubus-cube.js --bundle --format=esm --target=es2022 --outfile=vendor/cubus-cube.js",
    "predev": "node copy-ort.mjs && pnpm vendor:libs",
    "dev": "node serve.mjs",
    "test": "node --test",
    "check": "pnpm vendor:libs && node --test",
    "build:dist": "node build.mjs",
    "build:cubejs": "esbuild lib/cubejs-entry.js --bundle --format=esm --target=es2022 --outfile=vendor/cubejs.js",
    "build:mcp-guest": "esbuild lib/tauri-mcp-guest-entry.js --bundle --format=esm --target=es2022 --outfile=vendor/tauri-mcp-guest.js",
    "vendor:cubing": "node vendor-cubing.mjs",
    "vendor:libs": "pnpm build:cubejs && pnpm vendor:cubing"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "happy-dom": "^20.11.6",
    "playwright": "1.62.1",
    "tauri-plugin-mcp": "0.3.1",
    "three": "^0.169.0"
  },
  "dependencies": {
    "cubejs": "^1.3.2",
    "cubing": "^0.63.3"
  }
}
