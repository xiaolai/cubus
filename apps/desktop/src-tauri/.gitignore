# will have compiled files and executables
/target/
/gen/schemas
# App-command permissions, written by build.rs (`AppManifest::commands`) on every build so the
# capability files can be validated against them. A build output with no consumer outside the
# build: regenerated on a fresh clone before anything reads it (2026-09-05).
/permissions/autogenerated/

# The DirectML runtime the Windows release step copies out of target/ to bundle from a path
# nothing else writes (release.yml). A build output, never authored.
/gen/windows/
