{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cubus",
  "version": "0.1.0",
  "identifier": "im.cubus.app",
  "build": {
    "frontendDist": "../../web",
    "devUrl": "http://localhost:15173",
    "beforeDevCommand": "pnpm --filter cubus-web dev",
    "beforeBuildCommand": "pnpm --filter cube-scanner build:panel && pnpm --filter gan-driver build:driver && pnpm --filter cubus-web build:cube && pnpm --filter cubus-web copy-ort"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cubus",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 28 },
        "width": 1280,
        "height": 832,
        "minWidth": 1120,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/256x256.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  }
}
