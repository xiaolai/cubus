{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cubus",
  "version": "0.3.1",
  "identifier": "im.cubus.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:15173",
    "beforeDevCommand": "pnpm --filter cubus-web dev",
    "beforeBuildCommand": "pnpm --filter cube-scanner build:panel && pnpm --filter cubus-web build:cube && pnpm --filter cubus-web vendor:libs && pnpm --filter cubus-web build:smartcube && pnpm --filter cubus-web build:dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cubus",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 28
        },
        "create": false,
        "width": 1280,
        "height": 832,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/256x256.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "frameworks": [
        "CoreBluetooth"
      ]
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.macos.plist",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNzk4Rjk4NzEzOUQ5NjIKUldSaTJUbHhtSTk1T3FGTjRmdlRnVHJPMVN5RzJhV1UwWSt3eFNYNk8xTVNLTldkeEt3QWw2Y1YK",
      "endpoints": [
        "https://github.com/xiaolai/cubus/releases/latest/download/latest.json"
      ]
    }
  }
}
