<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The camera is the app's main instrument, but not a hard requirement: every screen works
         without a scan, so `required="false"` keeps the app installable on a device with no
         camera rather than hiding it from the store listing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Smart cube, optional in exactly the same sense. BLUETOOTH_SCAN carries
         neverForLocation because this app scans for a cube, never for where anyone is — the flag
         is what lets it ask for Bluetooth without dragging the location permission in behind it.
         The pre-API-31 pair is capped so it is not requested on systems that replaced it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Through API 30 a BLE SCAN is a location capability: without this the scan does not fail,
         it returns nothing, which reads as a cube that will not advertise. `neverForLocation` on
         BLUETOOTH_SCAN above is the API 31+ half of the same story. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- No Auto Backup. The WebView's localStorage IS the user's data — settings, the cube
         registry, recent solves — and with backup left at its default it went to the device's
         cloud account with no say from anyone. Nothing here is worth more than that promise;
         the app is offline by design and its state should stay on the device it was made on. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.cubus_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- No `screenOrientation` here: the lock is per device class (stage-contract decision 6,
             phones portrait, tablets free), and a manifest attribute locks every device alike.
             MainActivity.onCreate sets `requestedOrientation` from smallestScreenWidthDp. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
