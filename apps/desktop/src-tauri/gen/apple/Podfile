# One target: this project is the iOS shell only. The macOS app is the Tauri desktop build, not an
# Xcode target here, and the `cubus-desktop_macOS` target the scaffold declared named a target
# project.yml does not define — harmless until someone ran `pod install` and read the error.

target 'cubus-desktop_iOS' do
platform :ios, '16.0'
  # Pods for cubus-desktop_iOS
end

# Delete the deployment target for iOS, causing it to be inherited from the Podfile
post_install do |installer|
 installer.pods_project.targets.each do |target|
  target.build_configurations.each do |config|
   config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
  end
 end
end
