{
  "mcpServers": {
    "codex-cli": {
      "type": "stdio",
      "command": "codex",
      "args": [
        "mcp-server"
      ]
    },
    "tauri-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tauri-plugin-mcp-server@0.3.1"
      ],
      "env": {
        "TAURI_MCP_IPC_PATH": "/tmp/cubus-mcp.sock"
      }
    }
  }
}
