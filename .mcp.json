{
  "mcpServers": {
    "codex-cli": {
      "type": "stdio",
      "command": "codex",
      "args": [
        "mcp-server"
      ]
    },
    "tauri-mcp": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "TAURI_MCP_IPC_PATH=\"${TAURI_MCP_IPC_PATH:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/cubus-mcp.sock}\" exec npx -y tauri-plugin-mcp-server@0.3.1"
      ]
    }
  }
}
