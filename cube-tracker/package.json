{
  "name": "cube-tracker",
  "version": "0.1.0",
  "type": "module",
  "description": "Continuous visual state tracker for an uninstrumented Rubik's Cube — pure, tested belief core plus thin perception shells",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src view tests && eslint src",
    "format": "biome format --write src view tests",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:panel": "esbuild view/tracker-panel.ts --bundle --format=esm --target=es2022 --outfile=../app/renderer/vendor/tracker-panel.js"
  },
  "peerDependencies": {
    "cubejs": "^1.3.2"
  },
  "dependencies": {
    "culori": "^4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.9",
    "cubejs": "^1.3.2",
    "esbuild": "^0.21.5",
    "eslint": "^9.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.9"
  }
}
